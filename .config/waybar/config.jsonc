{
  "position": "top",
  // hyprland/workspaces is unusable with a hypr/hyprland.lua config: Hyprland
  // 0.56 evaluates socket1 `dispatch` payloads as Lua, and waybar hardcodes the
  // hyprlang form (`dispatch workspace 5`), which is a Lua syntax error -- so
  // clicks were silently dropped while the numbers still rendered correctly.
  // These modules send the Lua form. See waybar/hypr-ws.sh for the details.
  "modules-left": [
    "custom/ws1",
    "custom/ws2",
    "custom/ws3",
    "custom/ws4",
    "custom/ws5",
    "custom/ws6",
    "custom/ws7",
    "custom/ws8",
    "custom/ws9",
    "custom/ws10"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "hyprland/language",
    "pulseaudio",
    "clock",
    "custom/exit"
  ],
  "clock": {
    "format": "<span foreground='#f5c2e7'> </span>{:%a %B %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "months":  "<span color='#f5c2e7'><b>{}</b></span>",
        "days":    "<span color='#cdd6f4'>{}</span>",
        "weeks":   "<span color='#94e2d5'><b>W{}</b></span>",
        "weekdays":"<span color='#fab387'><b>{}</b></span>",
        "today":   "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        " "
      ]
    },
    "on-click": "pavucontrol"
  },
  "hyprland/language": {
    "format": "{}",
    "format-br": "BR",
    "format-en": "US"
  },
  "memory": {
    "interval": 2,
    "format": "{used:0.1f}G/{total:0.1f}G"
  },
  "cpu": {
    "interval": 2,
    "format": "C {usage}%"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 3
  },
  // Workspaces. One module per workspace so each number is independently
  // clickable. hypr-ws.sh prints empty text for workspaces that don't exist,
  // which hides the module -- same visible behaviour as hyprland/workspaces.
  // All ten share signal 8; hypr-ws-watch.py fires it on Hyprland workspace
  // events, and "interval": "once" means they only re-run on that signal.
  "custom/ws1": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 1",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
  },
  "custom/ws2": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 2",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
  },
  "custom/ws3": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 3",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
  },
  "custom/ws4": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 4",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
  },
  "custom/ws5": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 5",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
  },
  "custom/ws6": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 6",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'"
  },
  "custom/ws7": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 7",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'"
  },
  "custom/ws8": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 8",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'"
  },
  "custom/ws9": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 9",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'"
  },
  "custom/ws10": {
    "exec": "$HOME/.config/waybar/hypr-ws.sh 10",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'"
  },
  // Power Menu
  "custom/exit": {
    "format": "",
    "on-click": "wlogout",
    "on-click-right": "hyprlock",
    "tooltip-format": "Left: Power menu\nRight: Lock screen"
  }
}
